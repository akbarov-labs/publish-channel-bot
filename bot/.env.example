BOT_TOKEN=123456:replace-me
# Fernet key for encrypting per-tenant site tokens.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=replace-me
DATABASE_URL=sqlite+aiosqlite:///./bot.db
# Public base URL of this service, used for Telegram + site webhooks.
PUBLIC_BASE_URL=https://bot.example.com
# "polling" for local dev, "webhook" in production.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=replace-me
# "Request a page" presses: where to send them in Telegram (your user id),
# and the blog to record them on too. BOT_INTERNAL_SECRET matches blog/.env.
ADMIN_CHAT_ID=
BLOG_INTERNAL_URL=http://blog:8001/api
BOT_INTERNAL_SECRET=

# Premium's monthly price in Telegram Stars (up to 10000). Empty or 0 keeps it
# off sale. Needs BLOG_INTERNAL_URL and BOT_INTERNAL_SECRET; payment trouble and
# /paysupport messages go to ADMIN_CHAT_ID.
PREMIUM_PRICE_STARS=
