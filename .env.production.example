# The server's .env for docker-compose.prod.yml - one file for all three
# services. It lives at /opt/apps/publish-channel-bot/.env, root-owned, mode
# 600, and deploys never touch it. See DEPLOY.md.
#
# NEVER QUOTE VALUES. Compose passes quotes through literally, so
# APP_KEY="base64:..." reaches Laravel with the quotes and every request
# fails with "Unsupported cipher or incorrect key length".
#
# Generate every secret with `openssl rand -hex 32` unless noted: hex is safe
# in URLs, crontabs and Telegram's webhook secret alike.

# The reader site's root. Everything else derives from it:
#   https://DOMAIN            directory of authors
#   https://<author>.DOMAIN   each author's space
#   https://admin.DOMAIN      admin panel and blog API
#   https://bot.DOMAIN        the bot's webhooks
# DNS: an A record for DOMAIN and one for *.DOMAIN, both to 169.58.243.86.
DOMAIN=example.uz

# --- Blog (Laravel) -------------------------------------------------------
# echo "base64:$(openssl rand -base64 32)"   (51 characters, no quotes)
APP_KEY=
BLOG_DB_PASSWORD=
# Shown in the admin's title. Optional.
APP_NAME=Channels

# --- Bot ------------------------------------------------------------------
# From @BotFather. Staging gets its own test bot, never this one.
BOT_TOKEN=
# Encrypts each author's blog token at rest. A Fernet key:
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# Changing it later makes every stored token unreadable: authors would have
# to /connect again.
BOT_SECRET_KEY=
# Telegram signs every webhook call with this.
TELEGRAM_WEBHOOK_SECRET=
BOT_DB_PASSWORD=

# --- Reader site ----------------------------------------------------------
# Interface language of the root directory: uz, ru or en. Each author picks
# their own space's language on their admin Profile.
DEFAULT_LOCALE=uz
# The platform's name on the root directory and in footers.
SITE_NAME=Channels

# --- Inviting authors (optional) ---------------------------------------------
# Set both and the root domain invites channel owners: "Request a page" opens
# the bot, which forwards the request to ADMIN_CHAT_ID. Leave both empty for a
# plain directory. Staging uses its own bot here (e.g. postsuz_staging_bot).
# This stack's bot @username, without the @.
BOT_USERNAME=
# Your Telegram user id (ask @userinfobot), or a group's chat id. You must have
# sent the bot /start once, or Telegram won't let it message you.
ADMIN_CHAT_ID=

# --- Backups --------------------------------------------------------------
# Days of nightly database dumps kept in the db_backups volume. Optional.
BACKUP_RETENTION_DAYS=14
